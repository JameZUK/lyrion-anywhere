# Local TLS reverse proxy for testing the gateway (copy to dev/local.Caddyfile).
# Caddy issues a certificate from its own local CA; point clients at its root:
#   ~/.local/share/caddy/pki/authorities/local/root.crt
{
	skip_install_trust
	admin off
	auto_https disable_redirects
	http_port 8080
}
https://localhost:8443 {
	tls internal
	reverse_proxy 127.0.0.1:9443
}
