{
  "name": "lyrion-anywhere-web",
  "private": true,
  "version": "0.1.0",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "imports": {
    "#lib": "./src/lib",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node scripts/externalise-boot.mjs build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc --noEmit -p src/service-worker",
    "test": "vitest run && node --test tests/node/*.test.mjs"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "4.0.0",
    "@sveltejs/kit": "3.1.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@testing-library/svelte": "5.4.2",
    "@types/node": "26.6.5",
    "jsdom": "30.1.3",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "tslib": "2.8.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
