{
	"name": "Lyrion Anywhere",
	"short_name": "Lyrion",
	"description": "Your Lyrion music server, anywhere.",
	"id": "./",
	"start_url": "./",
	"scope": "./",
	"display": "standalone",
	"orientation": "any",
	"background_color": "#121212",
	"theme_color": "#c2410c",
	"lang": "en-GB",
	"categories": ["music", "entertainment"],
	"icons": [
		{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
		{ "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
		{ "src": "icons/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
		{ "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
		{ "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
	],
	"shortcuts": [
		{ "name": "Resume", "short_name": "Resume", "description": "Carry on playing where you left off", "url": "./#/go/resume", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
		{ "name": "Radio", "short_name": "Radio", "description": "Start radio from what is playing", "url": "./#/go/radio", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
		{ "name": "Search", "short_name": "Search", "description": "Search your library", "url": "./#/search", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] }
	]
}
