<?xml version="1.0" encoding="utf-8"?>
<!--
  No cleartext traffic, and only the system's certificate authorities. The Rust network
  layer verifies certificates through Android's own TrustManager, so this policy applies to
  it too. (Debug builds also allow plain HTTP to loopback, for a gateway on this device or
  forwarded with `adb reverse`; see src/debug.)
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
