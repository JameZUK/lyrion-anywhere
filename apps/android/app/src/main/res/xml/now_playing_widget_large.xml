<?xml version="1.0" encoding="utf-8"?>
<!-- The larger, resizable widget (Wave 2 §5.5): art, title, a progress line and the
     transport. No periodic updates (updatePeriodMillis 0), as the small one: the app redraws
     it when what it shows changes, so it never wakes the phone. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_large_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minWidth="250dp"
    android:minHeight="180dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="140dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
