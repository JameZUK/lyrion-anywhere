<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Only for scanning a pairing QR code; asked for when the user chooses to scan. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- "Play on this phone": a foreground media service, and staying awake (CPU and
         Wi-Fi) while it plays. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Offline downloads (A5): a foreground service of type dataSync while downloads run,
         and its progress notification (asked for when the user first downloads, Android
         13+). The data module adds ACCESS_NETWORK_STATE (Wi-Fi or mobile data). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Car mode opening by itself (Wave 2 §5.1): seeing which Bluetooth device connects and
         whether it is car audio. Asked for only when an automatic option is first chosen in
         Settings (Android 12+); refused, car mode is only a button. Names and addresses stay
         on the phone. Before Android 12 the older BLUETOOTH permission (granted at install)
         covers the same reads. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />

    <!-- Package visibility (Android 11+): the media session checks the signing certificate
         of each car or assistant app that connects (CallerPolicy.KNOWN), which it can only
         read for packages it can see. Exactly those three packages, and nothing broader
         (never the permission to see every package). -->
    <queries>
        <package android:name="com.google.android.projection.gearhead" />
        <package android:name="com.google.android.googlequicksearchbox" />
        <package android:name="com.google.android.carassistant" />
    </queries>

    <!--
      Security:
      - no backups of any kind: the sealed refresh token is useless elsewhere anyway (its
        Keystore key never leaves this device), and settings are trivial to re-enter;
      - cleartext traffic is refused by the network security configuration for Android's own
        HTTP stacks; the Rust layer makes the app's connections and refuses plain HTTP itself,
        except to loopback in development and to a literal private address (a VPN) after the
        user has been warned and agreed (docs/plans/trusted-networks.md).
    -->
    <application
        android:name=".LyrionApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.LyrionAnywhere"
        tools:targetApi="36">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Play … on Lyrion Anywhere" (voice): the spoken query is searched in the
                 library and the best match plays on this phone. Only the query text is
                 read, bounded, and it goes through the same search as the car's. -->
            <intent-filter>
                <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Pairing links, lyrion-anywhere://pair?server=…&code=… (e.g. tapped in a
                 message). A link only fills in the pairing screen: it is checked like a
                 scanned QR code, and nothing signs in, signs out or changes server until the
                 user confirms. Only the link's text is read (no extras). A custom scheme with
                 no autoVerify: there is no web domain to verify for a self-hosted server. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="lyrion-anywhere" android:host="pair" />
            </intent-filter>
            <!-- App shortcuts: Start radio and Sleep 30 min (Wave 2 §5.5). -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>
        <!--
          Where the app shortcuts land. Not exported: the launcher starts a shortcut as this
          app, so nothing else can reach it. It notes the request and opens the app, whose
          player controller acts on it.
        -->
        <activity
            android:name=".ShortcutActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />
        <!--
          The media session for "Play on this phone", and the media library for cars (A6).
          Exported, because Android Auto (and Android Automotive's media centre) bind to it
          from outside the app. Every caller is checked in its onConnect (CallerPolicy):
          Android Auto and the assistants only with their release certificates, the
          system's own controllers (platform-signed or holding MEDIA_CONTENT_CONTROL), and
          this app; other controllers Media3 trusts get transport controls only; anyone
          else is refused. The tree it serves holds no URLs or paths.
        -->
        <service
            android:name="io.github.jamezuk.lyrionanywhere.playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>
        <!-- Android Auto: a media app, served by the service above. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
        <!--
          Downloads in the background (A5): a dataSync foreground service, running only while
          downloads are busy. Not exported: only this app starts it; its notification's Cancel
          action is an explicit, immutable PendingIntent. (No WorkManager: its start-up
          initialiser crashed earlier test builds, see below.)
        -->
        <service
            android:name=".downloads.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <!--
          The home-screen widget. Exported because the launcher's widget host must reach it;
          it accepts only the widget update broadcast, which at worst redraws it. Its buttons
          go through Glance's own receiver, which is not exported.
        -->
        <receiver
            android:name=".widget.NowPlayingWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/now_playing_widget" />
        </receiver>
        <!--
          The larger widget (Wave 2 §5.5), as the one above: exported for the launcher's widget
          host, taking only the widget update broadcast.
        -->
        <receiver
            android:name=".widget.NowPlayingLargeWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_large_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/now_playing_widget_large" />
        </receiver>
        <!--
          Android Auto's album art (Wave 2 §5.2). NOT exported: Android Auto reads a cover only
          through a read-only grant for that one URI, given as its lists are sent. Serves only
          covers already fetched through the gateway, by opaque key; nothing can be written.
        -->
        <provider
            android:name="io.github.jamezuk.lyrionanywhere.playback.auto.AutoArtProvider"
            android:authorities="${applicationId}.autoart"
            android:exported="false"
            android:grantUriPermissions="true" />
        <!--
          Quick Settings play/pause. Exported for the system UI, and only the system can bind
          it (BIND_QUICK_SETTINGS_TILE is a signature permission).
        -->
        <service
            android:name=".widget.PlayPauseTileService"
            android:exported="true"
            android:icon="@drawable/ic_widget_play"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>
        <!-- The widget library brings WorkManager, whose start-up initialiser runs (and opens
             its database) before the app's own code on every launch. The app never schedules
             work (the widget renders directly), so it is not initialised at all. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:ignore="MissingClass"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
